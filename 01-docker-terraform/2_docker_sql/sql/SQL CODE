# Question 3
WITH DistanceGroups AS (
    SELECT
        CASE
            WHEN trip_distance <= 1 THEN 'up to 1 mile'
            WHEN trip_distance > 1 AND trip_distance <= 3 THEN 'up to 3 mile'
            WHEN trip_distance > 3 AND trip_distance <= 7 THEN 'up to 7 mile'
            WHEN trip_distance > 7 AND trip_distance <= 10 THEN 'up to 10 mile'
            ELSE 'over 10 miles'
        END AS distance_group
    FROM
        green_taxi_data
    WHERE
        lpep_pickup_datetime >= '2019-10-01' AND lpep_dropoff_datetime < '2019-11-01'
)
SELECT distance_group, COUNT(*) AS trips
FROM DistanceGroups
GROUP BY distance_group
ORDER BY
    CASE distance_group
        WHEN 'up to 1 mile' THEN 1
        WHEN 'up to 3 mile' THEN 2
        WHEN 'up to 7 mile' THEN 3
        WHEN 'up to 10 mile' THEN 4
        ELSE 5
    END;

# Question 4
SELECT (lpep_pickup_datetime::date) AS trip_date
FROM green_taxi_data
WHERE lpep_pickup_datetime::date IN ('2019-10-11', '2019-10-24', '2019-10-26', '2019-10-31')
GROUP BY lpep_pickup_datetime::date
ORDER BY MAX(trip_distance) DESC
LIMIT 1;

