# Question 5
WITH ZoneTotalAmounts AS (
    SELECT tz."Zone", SUM(gt.total_amount) AS total_amount_sum
    FROM public.green_taxi_data AS gt
    JOIN public.taxi_zone AS tz ON gt."PULocationID" = tz."LocationID"
    WHERE gt.lpep_pickup_datetime::date = '2019-10-18'
    GROUP BY tz."Zone"
)
SELECT "Zone", total_amount_sum
FROM ZoneTotalAmounts
WHERE total_amount_sum > 13000
ORDER BY total_amount_sum DESC
LIMIT 3;

# Question 6
WITH EastHarlemNorthTips AS (
    SELECT gt."DOLocationID", gt.tip_amount
    FROM public.green_taxi_data AS gt
    JOIN public.taxi_zone AS tz ON tz."LocationID" = gt."PULocationID"
    WHERE tz."Zone" = 'East Harlem North'
      AND gt.lpep_pickup_datetime::date BETWEEN '2019-10-01' AND '2019-10-31'),
MaxTipDropoff AS (
    SELECT "DOLocationID", MAX(tip_amount) as max_tip
    FROM EastHarlemNorthTips
    GROUP BY "DOLocationID"
    ORDER BY max_tip DESC
    LIMIT 1
)
SELECT tz."Zone"
FROM MaxTipDropoff
JOIN public.taxi_zone AS tz ON MaxTipDropoff."DOLocationID" = tz."LocationID";